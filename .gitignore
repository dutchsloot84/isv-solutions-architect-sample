# Local environment configuration
.env
*.pem
*.json
!schemas/*.json
~/.jira_token.json
/.secrets/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
data/snapshots/*
!data/snapshots/.gitkeep
reports/*.md
!reports/oauth_offline_access_painpoint_*.md
logs/*
!logs/oauth_diagnostics_*.json
